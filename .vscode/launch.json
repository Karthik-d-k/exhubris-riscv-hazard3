{
    "version": "0.2.0",
    "configurations": [
        {
            // "preLaunchTask": "Start OpenOCD",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe-rs-debug",
            "cwd": "${workspaceFolder}",
            "speed": 100,
            "runtimeExecutable": "probe-rs",
            "runtimeArgs": [
                "dap-server"
            ],
            "chip": "RP235x",
            "connectUnderReset": false,
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": false,
                "formatOptions": {
                    "binaryFormat": "elf"
                }
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": ".work/cortex-m33/final/kernel",
                    "svdFile": "C:\\Users\\adt8kor\\wws\\riscv\\hubris-riscv-hazard3\\chips\\rp2350-hazard3\\RP2350.svd"
                }
            ],
            "consoleLogLevel": "Debug"
        },
        {
            "name": "Pico Debug (External OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "loadFiles": [
                ".work/hazard3/final/kernel"
            ],
            "symbolFiles": [
                ".work/hazard3/final/idle",
                ".work/hazard3/final/super",
            ],
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "gdbPath": "riscv32-unknown-elf-gdb.exe",
            // Optional, gives you register/peripheral view in VS Code
            "svdFile": "C:/Users/adt8kor/wws/riscv/hubris-riscv-hazard3/chips/rp2350-hazard3/RP2350.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "postLaunchCommands": [
                "monitor arm semihosting enable",
            ],
            "toolchainPrefix": "riscv32-unknown-none-elf",
        },
        {
            "name": "Pico Debug (Integrated OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "loadFiles": [
                "${workspaceFolder}/.work/hazard3/final/kernel"
            ],
            "symbolFiles": [
                {
                    "file": "${workspaceFolder}/.work/hazard3/final/idle"
                },
                {
                    "file": "${workspaceFolder}/.work/hazard3/final/super"
                }
            ],
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "gdbPath": "riscv32-unknown-elf-gdb.exe",
            "svdFile": "C:/Users/adt8kor/wws/riscv/hubris-riscv-hazard3/chips/rp2350-hazard3/RP2350.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        },
    ]
}