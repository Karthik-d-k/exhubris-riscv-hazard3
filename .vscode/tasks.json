{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start OpenOCD",
            "type": "shell",
            "command": "openocd.exe -f app/demo-hazard3/openocd.cfg",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Listening on port",
                    "endsPattern": "."
                }
            }
        },
        {
            "label": "hubake build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "hubake build app\\demo-hazard3\\app.kdl; if (-not $?) { exit 1 }; ",
                "Expand-Archive -Path 'hazard3-build.zip' -DestinationPath 'hazard3-build/' -Force; if (-not $?) { exit 1 }; ",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Picotool reboot",
            "type": "shell",
            "command": "picotool reboot -u -c riscv",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}