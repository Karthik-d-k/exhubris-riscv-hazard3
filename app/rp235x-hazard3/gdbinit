  set $t6_prev  = $t6
end

# compare registers with previous snapshot
define diff_regs
  if $ra != $ra_prev
    printf "ra:  0x%x -> 0x%x\n", $ra_prev, $ra
  end
  if $sp != $sp_prev
    printf "sp:  0x%x -> 0x%x\n", $sp_prev, $sp
  end
  if $gp != $gp_prev
    printf "gp:  0x%x -> 0x%x\n", $gp_prev, $gp
