# save current register snapshot into convenience variables
define save_regs
  set $ra_prev  = $ra
  set $sp_prev  = $sp
  set $gp_prev  = $gp
  set $tp_prev  = $tp
  set $t0_prev  = $t0
  set $t1_prev  = $t1
  set $t2_prev  = $t2
  set $s0_prev  = $s0
  set $s1_prev  = $s1
  set $a0_prev  = $a0
  set $a1_prev  = $a1
  set $a2_prev  = $a2
  set $a3_prev  = $a3
  set $a4_prev  = $a4
  set $a5_prev  = $a5
  set $a6_prev  = $a6
  set $a7_prev  = $a7
  set $s2_prev  = $s2
