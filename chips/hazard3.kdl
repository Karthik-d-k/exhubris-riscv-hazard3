chip "hazard3"
target-triple "riscv32imac-unknown-none-elf"
vector-table-size 0x48 // .pico-sdk\sdk\2.1.1\src\rp2350\hardware_regs\include\hardware\platform_defs.h
probe-rs-name "RP235x"

compatible {
    - "rp2350-pico2"
    - "rp2350-pico2-w"
}

memory {
    region "vectors" {
        base 0x1000_0000 // XIP_BASE
        size 0x120 // enlarged to accommodate header
        read
    }
    region "flash" {
        base 0x1000_0120 // SRAM_BASE
        size 0x003F_FEE0 // 4MB (0x0040_0000) (FLASH) - 0x120 (vectors) = 0x3FFEE0
        read
        execute
    }
    region "ram" {
        base 0x2000_0000
        size 0x0008_2000 // Logically, there is a single 520KB contiguous memory
        read
        write
    }
}
